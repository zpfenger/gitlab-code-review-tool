[Unit]
Description=GitLab Code Review Tool
After=network.target

[Service]
Type=simple
User=gitlab-review
Group=gitlab-review
WorkingDirectory=/mnt/python/code-review
Environment="PATH=/mnt/python/code-review/venv/bin"
Environment="SECRET_KEY=your-secret-key-here"
Environment="CONFIG_PATH=/mnt/python/code-review/config/admin.yaml"
ExecStart=/mnt/python/code-review/venv/bin/python run.py --host 0.0.0.0 --port 5001 --workers 1
Restart=always
RestartSec=10

# Logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=gitlab-code-review

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
